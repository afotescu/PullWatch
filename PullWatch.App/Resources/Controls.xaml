          <Grid Background="Transparent">
            <Border
              Width="50"
              Height="10"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{StaticResource TextSecondaryBrush}"
              CornerRadius="5"
            />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
