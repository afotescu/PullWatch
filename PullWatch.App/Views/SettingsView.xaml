<UserControl
  x:Class="PullWatch.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:PullWatch"
>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="SettingsContentHost" Margin="16,24,32,24">
      <StackPanel
        x:Name="SettingsColumn"
        Width="{Binding ActualWidth, ElementName=SettingsContentHost}"
        MaxWidth="760"
        HorizontalAlignment="Center"
        IsEnabled="{Binding IsEditingEnabled}"
      >
        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Settings" />
        <TextBlock
          Margin="0,4,0,32"
          Style="{StaticResource SecondaryTextStyle}"
          Text="Configure how PullWatch records and stores gameplay."
        />

        <local:SectionCard Header="Folders" Style="{StaticResource FlatSettingsSectionStyle}">
          <StackPanel>
            <local:PathSettingRow
              Width="{Binding ActualWidth, ElementName=SettingsColumn}"
              MaxWidth="700"
              HorizontalAlignment="Left"
              Label="WoW logs directory"
              BrowseCommand="{Binding PickWowLogsDirectoryCommand}"
              CommitCommand="{Binding CommitWowLogsDirectoryCommand}"
              Error="{Binding WowLogsDirectoryError}"
              Text="{Binding WowLogsDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
            <local:PathSettingRow
              Width="{Binding ActualWidth, ElementName=SettingsColumn}"
              MaxWidth="700"
              HorizontalAlignment="Left"
              Label="Recordings directory"
              BrowseCommand="{Binding PickRecordingsDirectoryCommand}"
              CommitCommand="{Binding CommitRecordingsDirectoryCommand}"
              Error="{Binding RecordingsDirectoryError}"
              Text="{Binding RecordingsDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
          </StackPanel>
        </local:SectionCard>

        <local:SectionCard Header="Storage" Style="{StaticResource FlatSettingsSectionStyle}">
          <StackPanel>
            <Grid Margin="0,16,0,0" Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock
                  Style="{StaticResource ControlLabelTextStyle}"
                  Text="Managed recording storage"
                />
                <TextBlock
                  Margin="0,4,0,0"
                  Style="{StaticResource SecondaryTextStyle}"
                  Text="Automatically remove the oldest managed recordings after the storage limit is reached."
                />
              </StackPanel>
              <ToggleButton
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Managed recording storage"
                IsChecked="{Binding IsRecordingStorageLimitEnabled}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>

            <StackPanel
              Margin="0,18,0,0"
              IsEnabled="{Binding CanConfigureRecordingStorageLimit}"
              Style="{StaticResource DependentSettingsContentStyle}"
            >
              <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Storage limit"
              />
              <StackPanel Orientation="Horizontal">
                <TextBox
                  Width="100"
                  InputScope="Number"
                  local:TextBoxInput.AcceptsNonNegativeIntegerOnly="True"
                  local:TextBoxInput.FallbackTextWhenEmpty="1"
                  Style="{StaticResource TextInputStyle}"
                  Text="{Binding RecordingStorageLimitInputGigabytes, UpdateSourceTrigger=PropertyChanged}"
                />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="GB" />
                <Button
                  Margin="12,0,0,0"
                  Command="{Binding ApplyRecordingStorageLimitCommand}"
                  Content="Apply"
                  Style="{StaticResource SecondaryButtonStyle}"
                />
              </StackPanel>
            </StackPanel>
            <TextBlock
              Margin="0,14,0,0"
              Style="{StaticResource SecondaryTextStyle}"
              Text="{Binding RecordingStorageUsageText}"
            />
            <ProgressBar
              Width="{Binding ActualWidth, ElementName=SettingsColumn}"
              MaxWidth="700"
              HorizontalAlignment="Left"
              Margin="0,6,0,0"
              IsIndeterminate="{Binding IsRecordingStorageUsageIndeterminate, Mode=OneWay}"
              Maximum="100"
              Value="{Binding RecordingStorageUsagePercent, Mode=OneWay}"
              Visibility="{Binding IsRecordingStorageProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
              <ProgressBar.Style>
                <Style BasedOn="{StaticResource CompactProgressBarStyle}" TargetType="ProgressBar">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecordingStorageOverLimit}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <TextBlock
              Margin="0,6,0,0"
              Style="{StaticResource SecondaryTextStyle}"
              Text="{Binding RecordingStorageStatusText}"
            />
          </StackPanel>
        </local:SectionCard>

        <local:SectionCard
          Header="Automatic recording"
          Style="{StaticResource FlatSettingsSectionStyle}"
        >
          <StackPanel Margin="0,16,0,0">
            <Grid Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Record Mythic+"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Record Mythic+"
                IsChecked="{Binding RecordMythicPlus}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>

            <StackPanel
              Margin="0,10,0,0"
              IsEnabled="{Binding CanConfigureMythicPlus}"
              Style="{StaticResource DependentSettingsContentStyle}"
            >
              <TextBlock
                Margin="0,0,0,6"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Minimum keystone level"
              />
              <TextBox
                Width="120"
                HorizontalAlignment="Left"
                InputScope="Number"
                local:TextBoxInput.AcceptsNonNegativeIntegerOnly="True"
                local:TextBoxInput.FallbackTextWhenEmpty="0"
                Style="{StaticResource TextInputStyle}"
                Text="{Binding MinimumMythicPlusKeystoneLevel, UpdateSourceTrigger=PropertyChanged}"
              />
              <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Set to 0 to record every Mythic+ run. Higher values record runs at that key level or above."
              />
            </StackPanel>

            <Border Height="1" Margin="0,20" Background="{StaticResource BorderSubtleBrush}" />

            <Grid Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Record raid encounters"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Record raid encounters"
                IsChecked="{Binding RecordRaidEncounters}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>

            <StackPanel
              Margin="0,10,0,0"
              IsEnabled="{Binding CanConfigureRaidEncounters}"
              Style="{StaticResource DependentSettingsContentStyle}"
            >
              <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Difficulties"
              />
              <UniformGrid HorizontalAlignment="Left" Columns="2" Rows="2">
                <CheckBox
                  Width="150"
                  Margin="0,0,18,8"
                  IsChecked="{Binding RecordRaidFinder}"
                  Content="Raid Finder"
                />
                <CheckBox
                  Width="150"
                  Margin="0,0,18,8"
                  IsChecked="{Binding RecordNormalRaid}"
                  Content="Normal"
                />
                <CheckBox
                  Width="150"
                  Margin="0,0,18,0"
                  IsChecked="{Binding RecordHeroicRaid}"
                  Content="Heroic"
                />
                <CheckBox
                  Width="150"
                  Margin="0,0,18,0"
                  IsChecked="{Binding RecordMythicRaid}"
                  Content="Mythic"
                />
              </UniformGrid>
            </StackPanel>
          </StackPanel>
        </local:SectionCard>

        <local:SectionCard Header="Startup" Style="{StaticResource FlatSettingsSectionStyle}">
          <StackPanel Margin="0,16,0,0">
            <Grid Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Start PullWatch when Windows starts"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Start PullWatch when Windows starts"
                IsChecked="{Binding StartWithWindows}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>

            <Grid
              MaxWidth="684"
              Margin="16,14,0,0"
              IsEnabled="{Binding CanStartMinimizedToTray}"
              Style="{StaticResource DependentSettingsRowStyle}"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Start minimized to tray when launched by Windows"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Start minimized to tray when launched by Windows"
                IsChecked="{Binding StartMinimizedToTray}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>
          </StackPanel>
        </local:SectionCard>

        <local:SectionCard Header="Video" Style="{StaticResource FlatSettingsSectionStyle}">
          <StackPanel Margin="0,16,0,0">
            <TextBlock Style="{StaticResource ControlLabelTextStyle}" Text="Video encoding" />
            <Grid Width="420" Margin="0,5,0,0" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="{Binding VideoEncodingSummary}" />
                <TextBlock
                  Margin="0,4,0,0"
                  Style="{StaticResource SecondaryTextStyle}"
                  Text="{Binding VideoEncodingStatus}"
                />
              </StackPanel>
              <Button
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding TestVideoEncodingCommand}"
                Content="{Binding TestVideoEncodingButtonText}"
                Style="{StaticResource SecondaryButtonStyle}"
              />
            </Grid>

            <TextBlock
              Style="{StaticResource CompactInputLabelStyle}"
              Text="Encoder profile"
              Visibility="{Binding HasVideoProfileOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
            />
            <ComboBox
              Width="420"
              HorizontalAlignment="Left"
              DisplayMemberPath="Label"
              IsEnabled="{Binding CanChooseVideoProfile}"
              ItemsSource="{Binding VideoProfileOptions}"
              SelectedValue="{Binding SelectedVideoProfile, Mode=TwoWay}"
              SelectedValuePath="Value"
              Visibility="{Binding HasVideoProfileOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
            />

            <TextBlock Style="{StaticResource CompactInputLabelStyle}" Text="Video quality" />
            <ComboBox
              Width="420"
              HorizontalAlignment="Left"
              DisplayMemberPath="Label"
              ItemsSource="{Binding VideoQualityOptions}"
              SelectedValue="{Binding SelectedVideoQuality, Mode=TwoWay}"
              SelectedValuePath="Value"
            />

            <TextBlock Style="{StaticResource CompactInputLabelStyle}" Text="Frame rate" />
            <ComboBox
              Width="420"
              HorizontalAlignment="Left"
              DisplayMemberPath="Label"
              ItemsSource="{Binding FrameRateOptions}"
              SelectedValue="{Binding SelectedFrameRate, Mode=TwoWay}"
              SelectedValuePath="Value"
            />

            <TextBlock Style="{StaticResource CompactInputLabelStyle}" Text="Output scaling" />
            <ComboBox
              Width="420"
              HorizontalAlignment="Left"
              DisplayMemberPath="Label"
              ItemsSource="{Binding VideoScalingOptions}"
              SelectedValue="{Binding SelectedVideoScaling, Mode=TwoWay}"
              SelectedValuePath="Value"
            />
            <TextBlock
              Width="420"
              Margin="0,8,0,0"
              HorizontalAlignment="Left"
              Style="{StaticResource SecondaryTextStyle}"
              Text="{Binding EstimatedRecordingSize}"
            />

            <Border Height="1" Margin="0,20" Background="{StaticResource BorderSubtleBrush}" />

            <Grid Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Capture cursor"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Capture cursor"
                IsChecked="{Binding CaptureCursor}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>

            <Grid Margin="0,14,0,0" Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Show capture border"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Show capture border"
                IsChecked="{Binding ShowCaptureBorder}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>
          </StackPanel>
        </local:SectionCard>

        <local:SectionCard Header="Audio" Style="{StaticResource FlatSettingsSectionStyle}">
          <StackPanel Margin="0,16,0,0">
            <Grid Style="{StaticResource SettingsSwitchRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Capture system audio"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Capture system audio"
                IsChecked="{Binding CaptureSystemAudio}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>

            <Grid
              Margin="0,14,0,0"
              IsEnabled="{Binding CanCaptureMicrophone}"
              Style="{StaticResource DependentSettingsRowStyle}"
            >
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Style="{StaticResource ControlLabelTextStyle}"
                Text="Capture microphone"
              />
              <ToggleButton
                Grid.Column="1"
                AutomationProperties.Name="Capture microphone"
                IsChecked="{Binding CaptureMicrophone}"
                Style="{StaticResource SwitchStyle}"
              />
            </Grid>
          </StackPanel>
        </local:SectionCard>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
