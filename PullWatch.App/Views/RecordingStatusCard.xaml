<UserControl
  x:Class="PullWatch.RecordingStatusCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:PullWatch"
>
  <Border
    Padding="0,14"
    BorderBrush="{StaticResource BorderSubtleBrush}"
    BorderThickness="0,1"
    ToolTip="{Binding ReadinessDetail}"
    ToolTipService.InitialShowDelay="250"
    ToolTipService.ShowDuration="12000"
  >
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <local:RecordingStatusIndicator
          Grid.Column="0"
          Width="9"
          Height="9"
          Margin="0,4,8,0"
          IsPulseActive="{Binding IsRecordingPulseActive}"
          State="{Binding RecorderState}"
        />

        <TextBlock
          Grid.Column="1"
          FontSize="13"
          FontWeight="SemiBold"
          Text="{Binding RecorderStateLabel}"
          TextTrimming="CharacterEllipsis"
        >
          <TextBlock.Style>
            <Style
              BasedOn="{StaticResource {x:Type TextBlock}}"
              TargetType="TextBlock"
            >
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding RecorderState}"
                  Value="{x:Static local:RecorderPresentationState.Idle}"
                >
                  <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
                </DataTrigger>
                <DataTrigger
                  Binding="{Binding RecorderState}"
                  Value="{x:Static local:RecorderPresentationState.Ready}"
                >
                  <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger
                  Binding="{Binding RecorderState}"
                  Value="{x:Static local:RecorderPresentationState.Starting}"
                >
                  <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger
                  Binding="{Binding RecorderState}"
                  Value="{x:Static local:RecorderPresentationState.Stopping}"
                >
                  <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger
                  Binding="{Binding RecorderState}"
                  Value="{x:Static local:RecorderPresentationState.Error}"
                >
                  <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock
          Grid.Column="2"
          Margin="8,0,0,0"
          FontFamily="{StaticResource MonospaceFontFamily}"
          FontSize="12"
          Foreground="{StaticResource TextSecondaryBrush}"
          Text="{Binding Duration}"
          Visibility="{Binding IsRecorderTimerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
        />
      </Grid>

      <TextBlock
        Margin="17,5,0,0"
        Style="{StaticResource SecondaryTextStyle}"
        Text="{Binding RecorderDescription}"
        TextWrapping="Wrap"
      />

      <TextBlock
        Margin="17,12,0,0"
        FontSize="13"
        FontWeight="SemiBold"
        Text="{Binding RecorderContextDisplay}"
        TextTrimming="CharacterEllipsis"
        Visibility="{Binding IsRecorderContextVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
      />

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
          Grid.Column="0"
          HorizontalAlignment="Stretch"
          Command="{Binding StatusCardCommand}"
          Content="{Binding StatusCardButtonText}"
        >
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusCardStopMode}" Value="True">
                  <Setter Property="Background" Value="{StaticResource RecordingBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource RecordingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecorderError}" Value="True">
                  <Setter Property="Padding" Value="10,7" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <Button
          Grid.Column="1"
          Margin="8,0,0,0"
          Padding="10,7"
          Command="{Binding ViewDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=local:RecordingStatusCard}}"
          Content="View diagnostics"
          Style="{StaticResource SecondaryButtonStyle}"
          Visibility="{Binding IsRecorderError, Converter={StaticResource BooleanToVisibilityConverter}}"
        />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
