<UserControl
  x:Class="PullWatch.NotificationOverlayControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:PullWatch"
  Focusable="False"
>
  <UserControl.Resources>
    <Style
      x:Key="NotificationActionButtonStyle"
      BasedOn="{StaticResource PrimaryButtonStyle}"
      TargetType="Button"
    >
      <Setter Property="MinWidth" Value="122" />
      <Setter Property="MaxWidth" Value="180" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
      x:Key="NotificationDismissButtonStyle"
      BasedOn="{StaticResource IconButtonStyle}"
      TargetType="Button"
    >
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="Dismiss" />
    </Style>
  </UserControl.Resources>

  <ItemsControl
    ItemsSource="{Binding Items}"
    Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
  >
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type local:NotificationViewModel}">
        <Border
          Margin="0,0,0,10"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="7"
          Padding="0"
        >
          <Grid MinHeight="72">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6,0,0,6">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding Severity}"
                      Value="{x:Static local:NotificationSeverity.Success}"
                    >
                      <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger
                      Binding="{Binding Severity}"
                      Value="{x:Static local:NotificationSeverity.Warning}"
                    >
                      <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger
                      Binding="{Binding Severity}"
                      Value="{x:Static local:NotificationSeverity.Error}"
                    >
                      <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>

            <StackPanel Grid.Column="1" Margin="18,13,18,13" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{Binding Message}"
              />
            </StackPanel>

            <Button
              Grid.Column="2"
              Margin="0,0,14,0"
              Command="{Binding ActionCommand}"
              Style="{StaticResource NotificationActionButtonStyle}"
              Visibility="{Binding IsActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
              <TextBlock
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Text="{Binding ActionText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
              />
            </Button>

            <Button
              Grid.Column="3"
              Margin="0,0,14,0"
              Command="{Binding DismissCommand}"
              Style="{StaticResource NotificationDismissButtonStyle}"
              Visibility="{Binding IsDismissVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
              <Path
                Width="12"
                Height="12"
                Data="{x:Static local:ShellIconGeometries.Close}"
                Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.8"
              />
            </Button>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
