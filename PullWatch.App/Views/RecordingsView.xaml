<UserControl
  x:Class="PullWatch.RecordingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:PullWatch"
>
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="PlayerRow" Height="*" MinHeight="320" />
        <RowDefinition x:Name="SplitterRow" Height="18" />
        <RowDefinition x:Name="RecordingListRow" Height="200" MinHeight="200" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <ContentControl x:Name="PlayerHost">
          <local:RecordingPlayerControl
            x:Name="RecordingPlayer"
            Notifications="{Binding Notifications}"
            PlaceholderText="{Binding RecordingLibraryStatus}"
            Source="{Binding SelectedRecording.Source}"
          />
        </ContentControl>
      </Grid>

      <GridSplitter
        x:Name="PlayerListSplitter"
        Grid.Row="1"
        Height="18"
        Margin="0,10,0,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Style="{StaticResource SplitterGripStyle}"
      />

      <Grid x:Name="RecordingListPanel" Grid.Row="2" Margin="18,0,18,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ListBox
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ItemContainerStyle="{StaticResource RecordingFilterItemStyle}"
            ItemsSource="{Binding RecordingCategories}"
            SelectedItem="{Binding SelectedRecordingCategory, Mode=TwoWay}"
            SelectionChanged="OnRecordingCategoryChanged"
            Style="{StaticResource RecordingFilterListStyle}"
          >
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Text="{Binding Title}"
                    TextWrapping="NoWrap"
                  />
                  <TextBlock
                    Margin="6,0,0,0"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                    Opacity="0.72"
                    Text="{Binding Count}"
                    TextWrapping="NoWrap"
                  />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Command="{Binding OpenRecordingsFolderCommand}"
            Content="Open folder"
            Style="{StaticResource SecondaryButtonStyle}"
          />
        </Grid>

        <Grid Grid.Row="1" Margin="12,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="42" />
            <ColumnDefinition Width="{Binding ScrollBarColumnWidth}" />
          </Grid.ColumnDefinitions>

          <TextBlock
            Grid.Column="0"
            Style="{StaticResource RecordingLibraryHeaderTextStyle}"
            Text="Recording"
          />
          <TextBlock
            Grid.Column="1"
            Margin="16,0,0,0"
            Style="{StaticResource RecordingLibraryHeaderTextStyle}"
            Text="Started"
          />
          <TextBlock
            Grid.Column="2"
            Style="{StaticResource RecordingLibraryHeaderTextStyle}"
            TextAlignment="Right"
            Text="Duration"
          />
        </Grid>

        <Grid Grid.Row="2">
          <ListBox
            x:Name="RecordingList"
            Background="Transparent"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Foreground="{StaticResource TextPrimaryBrush}"
            ItemContainerStyle="{StaticResource RecordingLibraryItemStyle}"
            ItemsSource="{Binding Recordings}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            SelectedItem="{Binding SelectedRecording, Mode=TwoWay}"
            VirtualizingPanel.ScrollUnit="Pixel"
          >
            <ListBox.Resources>
              <Style BasedOn="{StaticResource VerticalScrollBarStyle}" TargetType="ScrollBar" />
            </ListBox.Resources>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding ToolTip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="42" />
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding Activity}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap"
                    />
                    <StackPanel
                      Grid.Row="1"
                      Margin="0,3,0,0"
                      Orientation="Horizontal"
                      Visibility="{Binding IsContextVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    >
                      <TextBlock
                        FontSize="12"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{Binding Context}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                      />
                      <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="·"
                      />
                      <TextBlock
                        FontSize="12"
                        Text="{Binding Result}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                      >
                        <TextBlock.Style>
                          <Style
                            BasedOn="{StaticResource SecondaryTextStyle}"
                            TargetType="TextBlock"
                          >
                            <Style.Triggers>
                              <DataTrigger
                                Binding="{Binding ResultKind}"
                                Value="{x:Static local:RecordingResultKind.Success}"
                              >
                                <Setter
                                  Property="Foreground"
                                  Value="{StaticResource SuccessBrush}"
                                />
                              </DataTrigger>
                              <DataTrigger
                                Binding="{Binding ResultKind}"
                                Value="{x:Static local:RecordingResultKind.Failure}"
                              >
                                <Setter
                                  Property="Foreground"
                                  Value="{StaticResource DangerMutedBrush}"
                                />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="·"
                        Visibility="{Binding IsPullNumberVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      />
                      <TextBlock
                        FontSize="12"
                        Style="{StaticResource SecondaryTextStyle}"
                        Visibility="{Binding IsPullNumberVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      >
                        <Run Text="Pull " />
                        <Run Text="{Binding PullNumber}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>

                  <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{Binding StartedAt}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                  />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{Binding Duration}"
                    TextAlignment="Right"
                    TextWrapping="NoWrap"
                  />
                  <Button
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnRecordingActionsClick"
                    Content="⋯"
                    Style="{StaticResource RecordingOverflowButtonStyle}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="Recording actions"
                  >
                    <Button.ContextMenu>
                      <ContextMenu
                        DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                        Placement="Bottom"
                        Style="{StaticResource ActionContextMenuStyle}"
                      >
                        <MenuItem
                          Command="{Binding DeleteSelectedRecordingCommand}"
                          Header="Delete"
                          Style="{StaticResource DangerActionMenuItemStyle}"
                        />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Text="{Binding RecordingLibraryStatus}"
            TextAlignment="Center"
            TextWrapping="Wrap"
          >
            <TextBlock.Style>
              <Style BasedOn="{StaticResource SecondaryTextStyle}" TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Recordings.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
