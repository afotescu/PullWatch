<UserControl
  x:Class="PullWatch.DiagnosticsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:PullWatch"
>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="DiagnosticsContentHost" Margin="16,24,32,24">
      <StackPanel
        Width="{Binding ActualWidth, ElementName=DiagnosticsContentHost}"
        MaxWidth="760"
        HorizontalAlignment="Center"
      >
        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Diagnostics" />
        <TextBlock
          Margin="0,4,0,32"
          Style="{StaticResource SecondaryTextStyle}"
          Text="Review application state and recent logs when troubleshooting PullWatch."
        />

        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="System status" />
        <Border Height="1" Margin="0,8,0,12" Background="{StaticResource BorderSubtleBrush}" />

        <Border Style="{StaticResource SurfacePanelStyle}">
          <ItemsControl AlternationCount="3" ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderSubtleBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderThickness" Value="0,0,0,1" />
                      <Setter Property="Padding" Value="0,12" />
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                          Value="0"
                        >
                          <Setter Property="Padding" Value="0,0,0,12" />
                        </DataTrigger>
                        <DataTrigger
                          Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                          Value="2"
                        >
                          <Setter Property="BorderThickness" Value="0" />
                          <Setter Property="Padding" Value="0,12,0,0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" Margin="0,0,24,0" Orientation="Horizontal">
                        <Ellipse Margin="0,0,10,0" VerticalAlignment="Center">
                          <Ellipse.Style>
                            <Style
                              BasedOn="{StaticResource SemanticStatusDotStyle}"
                              TargetType="Ellipse"
                            >
                              <Style.Triggers>
                                <DataTrigger
                                  Binding="{Binding Indicator}"
                                  Value="{x:Static local:DiagnosticIndicatorKind.Success}"
                                >
                                  <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                  <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding Indicator}"
                                  Value="{x:Static local:DiagnosticIndicatorKind.Warning}"
                                >
                                  <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                  <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding Indicator}"
                                  Value="{x:Static local:DiagnosticIndicatorKind.Recording}"
                                >
                                  <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                  <Setter
                                    Property="Stroke"
                                    Value="{StaticResource SuccessBrush}"
                                  />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding Indicator}"
                                  Value="{x:Static local:DiagnosticIndicatorKind.Error}"
                                >
                                  <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                  <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                          Style="{StaticResource ControlLabelTextStyle}"
                          Text="{Binding Title}"
                        />
                      </StackPanel>

                      <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{Binding State}"
                      />
                    </Grid>

                    <ItemsControl Margin="18,10,0,0" ItemsSource="{Binding Details}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="150" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                              Grid.Column="0"
                              Margin="0,0,16,0"
                              Style="{StaticResource MutedTextStyle}"
                              Text="{Binding Label}"
                            />
                            <TextBlock
                              Grid.Column="1"
                              Style="{StaticResource SecondaryTextStyle}"
                              Text="{Binding Value}"
                              TextWrapping="Wrap"
                            />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock
          Margin="0,32,0,0"
          Style="{StaticResource SectionTitleStyle}"
          Text="Recent application logs"
        />
        <Border Height="1" Margin="0,8,0,12" Background="{StaticResource BorderSubtleBrush}" />

        <TextBox
          Height="320"
          AcceptsReturn="True"
          IsReadOnly="True"
          Style="{StaticResource ConsoleTextBoxStyle}"
          Text="{Binding RecentLogs, Mode=OneWay}"
          TextWrapping="NoWrap"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
        />

        <Border Margin="0,16,0,12" Style="{StaticResource WarningPanelStyle}">
          <StackPanel>
            <TextBlock
              Style="{StaticResource ControlLabelTextStyle}"
              Text="Review before sharing"
            />
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource SecondaryTextStyle}"
              Text="Diagnostics can include local file paths, WoW window details, and recent application log messages."
            />
          </StackPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button
            Grid.Column="0"
            Command="{Binding CopyDiagnosticsCommand}"
            Content="Copy diagnostics"
            Style="{StaticResource PrimaryButtonStyle}"
          />
          <Button
            Grid.Column="1"
            Margin="10,0,0,0"
            Command="{Binding ExportDiagnosticsCommand}"
            Content="Export diagnostics"
            Style="{StaticResource SecondaryButtonStyle}"
          />
          <TextBlock
            Grid.Column="2"
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource SecondaryTextStyle}"
            Text="{Binding ActionMessage}"
          />
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
