{
  "name": "pullwatch.electron",
  "productName": "pullwatch.electron",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run check && electron-forge package",
