    "publish": "npm run check && electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch --preserveWatchOutput",
    "check": "npm run lint && npm run typecheck"
  },
