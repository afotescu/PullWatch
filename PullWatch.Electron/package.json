  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run check && electron-forge package",
    "make": "npm run check && electron-forge make",
    "publish": "npm run check && electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch --preserveWatchOutput",
    "ui:add": "shadcn add",
    "check": "npm run lint && npm run typecheck"
  },
